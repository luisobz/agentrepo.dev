# ============================================================================
# AgentRepo.dev — Environment Variables
# Duplicate as '.env' and fill in your values. Organize by environment:
# local development uses sensible defaults; production via cPanel UI.
# ============================================================================

# --- GLOBAL (Backend + Shared) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentrepo?schema=public"
AUTH_SECRET=your_auth_secret_here
SEED_ENCRYPTION_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- GLOBAL BACKEND (both backend-web & backend-ai) ---
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Shared secret guarding the backend-web → backend-ai internal endpoint.
# REQUIRED in production: must be a random value of at least 32 chars
# (boot fails otherwise). The 'dev-internal-secret' default is dev-only.
INTERNAL_API_SECRET=your_internal_api_secret_key_here
# Origins allowed by the backends' CORS policy.
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# --- WEB BACKEND (backend-web specific) ---
BACKEND_AI_URL=http://localhost:4001
SPACEMAIL_HOST=mail.spacemail.com
SPACEMAIL_PORT=465
SPACEMAIL_USER=agent@agentrepo.dev
SPACEMAIL_PASS=your_spacemail_password_here
CONTACT_NOTIFICATION_EMAIL=info@agentrepo.com

# --- AI BACKEND (backend-ai specific) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- LOCAL DEVELOPMENT ONLY ---
WEB_PORT=3000
ADMIN_PORT=3001
BACKEND_WEB_PORT=4000
BACKEND_AI_PORT=4001
DEV_ADMIN_PASSWORD=


