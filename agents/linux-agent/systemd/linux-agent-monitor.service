[Unit]
Description=Linux Agent sustained alarms and recovery notices
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=linux-agent-bot
Group=linux-agent-bot
ExecStart=/usr/bin/python3 -Es /opt/linux-agent/monitor.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/linux-agent-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
TimeoutStartSec=90
