[Unit]
Description=Linux Agent isolated Codex sessions
After=network-online.target linux-agent-bot.service
Wants=network-online.target
[Service]
User=linux-agent
Group=linux-agent
WorkingDirectory=/opt/linux-agent/workspace/work
Environment=HOME=/var/lib/linux-agent
ExecStart=/usr/bin/python3 -Es /opt/linux-agent/bridge.py
RuntimeDirectory=linux-agent-heartbeat
RuntimeDirectoryMode=0755
UMask=0077
Restart=always
RestartSec=10
KillMode=control-group
[Install]
WantedBy=multi-user.target
